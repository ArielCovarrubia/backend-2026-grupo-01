# — Base de datos ——————————————————————————————————————————
# Usada al ejecutar sin Docker. Docker Compose arma su propia URL de PostgreSQL.
DATABASE_URL=sqlite:///./habitos.db

# — PostgreSQL (docker-compose) ———————————————————————————————
POSTGRES_USER=postgres
# Obligatoria. Usar solo letras y números (se inserta en la URL de conexión).
POSTGRES_PASSWORD=
POSTGRES_DB=habitos

# — Puertos publicados en el equipo —————————————————————————————
API_PORT=8000
ADMINER_PORT=8080
MAILPIT_PORT=8025

# — Seguridad JWT ——————————————————————————————————————————
# Obligatoria con Docker. Generar con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# — Correo de prueba (reservado para el envío de recuperación) ——————————
SMTP_HOST=mailpit
SMTP_PORT=1025