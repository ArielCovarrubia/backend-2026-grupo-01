# ─── Base de datos ────────────────────────────────────────────────────────────

# SQLite (por defecto, para desarrollo local sin Docker):
DATABASE_URL=sqlite:///./habitos.db

# PostgreSQL con Docker Compose (descomentar y comentar la línea SQLite):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/habitos

# ─── Credenciales PostgreSQL (usadas por docker-compose.yml) ──────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=habitos

# ─── Seguridad JWT ────────────────────────────────────────────────────────────
# SECRET_KEY=cambia_esto_por_una_clave_secreta_segura
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
